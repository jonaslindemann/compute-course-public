from math import *

sum = 0.0
err = 1e-2
k = 1

while abs(pi-4*sum)>err:
    sum += pow(-1, k+1) / (2*k-1)
    k = k + 1
    print("Iteration", k, "pi = ", 4*sum, "err = ", abs(-pi-4*sum))





